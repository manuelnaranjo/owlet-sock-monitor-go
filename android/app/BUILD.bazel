load("@rules_android//android:rules.bzl", "android_application")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

VERSION_CODE = "4"

# ── TV ──────────────────────────────────────────────────────────────────────

kt_android_library(
    name = "tv_lib",
    srcs = glob(
        ["src/main/kotlin/**/*.kt"],
        exclude = [
            "**/PhoneMainActivity.kt",
            "**/OwletCarAppService.kt",
            "**/OwletCarSession.kt",
            "**/VitalsCarScreen.kt",
            "**/OwletDreamService.kt",
        ],
    ),
    custom_package = "com.owletmonitor.tv",
    manifest = "src/main/tv/AndroidManifest.xml",
    resource_files = glob(["src/main/res/**"]),
    deps = [],
)

android_application(
    name = "owlet_tv_unsigned_bundle",
    bundle_config_file = "bundle_config.pb.json",
    manifest = "src/main/tv/AndroidManifest.xml",
    manifest_values = {
        "applicationId": "com.manuelnaranjo.owletmonitor.tv",
        "versionCode": VERSION_CODE,
        "versionName": "1.0.1",
    },
    resource_files = glob(["src/main/res/**"]),
    deps = [":tv_lib"],
)

sh_binary(
    name = "owlet_tv_bundle",
    srcs = ["sign.sh"],
    data = [
        ":owlet_tv_unsigned_bundle_unsigned.aab",
        "@rules_java//toolchains:current_host_java_runtime",
    ],
    deps = ["@rules_shell//shell/runfiles"],
    toolchains = ["@rules_java//toolchains:current_host_java_runtime"],
    env = {
        "JAVABASE": "$(JAVABASE)",
        "SRC": "$(rootpath :owlet_tv_unsigned_bundle_unsigned.aab)",
    },
)

# ── Mobile + Auto ────────────────────────────────────────────────────────────

kt_android_library(
    name = "mobile_lib",
    srcs = glob(
        ["src/main/kotlin/**/*.kt"],
        exclude = [
            "**/MainActivity.kt",
            "**/OwletDreamService.kt",
        ],
    ),
    custom_package = "com.owletmonitor.tv",
    manifest = "src/main/mobile/AndroidManifest.xml",
    resource_files = glob(["src/main/res/**"]),
    deps = [
        "@maven//:androidx_car_app_app",
    ],
)

android_application(
    name = "owlet_mobile_unsigned_bundle",
    bundle_config_file = "bundle_config.pb.json",
    manifest = "src/main/mobile/AndroidManifest.xml",
    manifest_values = {
        "applicationId": "com.manuelnaranjo.owletmonitor.mobile",
        "versionCode": VERSION_CODE,
        "versionName": "1.0.0",
    },
    resource_files = glob(["src/main/res/**"]),
    deps = [":mobile_lib"],
)

sh_binary(
    name = "owlet_mobile_bundle",
    srcs = ["sign.sh"],
    data = [
        ":owlet_mobile_unsigned_bundle_unsigned.aab",
        "@rules_java//toolchains:current_host_java_runtime",
    ],
    deps = ["@rules_shell//shell/runfiles"],
    toolchains = ["@rules_java//toolchains:current_host_java_runtime"],
    env = {
        "JAVABASE": "$(JAVABASE)",
        "SRC": "$(rootpath :owlet_mobile_unsigned_bundle_unsigned.aab)",
    },
)
