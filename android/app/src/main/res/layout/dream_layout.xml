<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen screensaver layout. Dark background keeps it TV-friendly. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- widget_container is animated by OwletDreamService to prevent burn-in -->
    <LinearLayout
        android:id="@+id/widget_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/widget_background"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center">

        <!-- App title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:alpha="0.6"
            android:layout_marginBottom="16dp" />

        <!-- Charging indicator (shown in place of metrics when charging) -->
        <TextView
            android:id="@+id/tv_charging"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_charging"
            android:textColor="#FFB300"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- All vitals — hidden when charging -->
        <LinearLayout
            android:id="@+id/container_metrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Oxygen saturation -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_oxygen"
                android:textColor="#80FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_oxygen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="–– %"
                android:textColor="#4FC3F7"
                android:textSize="48sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Heart rate -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_heart_rate"
                android:textColor="#80FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_heart_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="–– bpm"
                android:textColor="#EF9A9A"
                android:textSize="48sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Sleep state -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_sleep_state"
                android:textColor="#80FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_sleep_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="––"
                android:textColor="#FFD54F"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sleep_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFD54F"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- Sock connection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_sock_connection"
                android:textColor="#80FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_sock_connection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="––"
                android:textColor="#A5D6A7"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Skin temperature -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_skin_temp"
                android:textColor="#80FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_skin_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="––"
                android:textColor="#80DEEA"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Status -->
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_waiting"
                android:textColor="#A5D6A7"
                android:textSize="20sp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <!-- Last updated — always visible -->
        <TextView
            android:id="@+id/tv_last_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_connecting"
            android:textColor="#50FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>
